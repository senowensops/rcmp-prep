# Local development works without external services. Leave these blank unless
# connecting to a development Supabase project. Never commit real credentials.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Server-only admin metrics token. Generate with: openssl rand -hex 32
# Requests require Authorization: Bearer <ADMIN_API_KEY>. Blank disables access.
ADMIN_API_KEY=

# Legacy purchase integrations; not required for the free practice app.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Set to your analytics property when testing analytics intentionally.
# Existing app behavior falls back to the production GA property if blank.
NEXT_PUBLIC_GA_ID=
